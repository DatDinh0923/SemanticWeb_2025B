# CQ4: Which matches in a season ended in a draw? Uses the foot:Draw class.
PREFIX foot: <https://datdinh0923.github.io/SemanticWeb_2025B/ontology/>
PREFIX schema: <https://schema.org/>
PREFIX season: <https://datdinh0923.github.io/SemanticWeb_2025B/resource/season/>

SELECT ?date ?homeName ?awayName ?goals
WHERE {
    VALUES ?season { season:premier-league-2018-19 }
    ?match a foot:Draw ;
           foot:playedInSeason ?season ;
           foot:matchDate ?date ;
           foot:homeTeam/schema:name ?homeName ;
           foot:awayTeam/schema:name ?awayName ;
           foot:homeGoals ?goals .
}
ORDER BY ?date ?homeName
