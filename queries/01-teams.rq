PREFIX fb: <http://example.org/phongph5/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Tokens are bound by src/query.py, not raw user input.
SELECT DISTINCT ?team ?name WHERE {
 ?match fb:inSeason {{season}} ; (fb:homeTeam|fb:awayTeam) ?team .
 ?team rdfs:label ?name .
} ORDER BY ?name
