PREFIX fb: <http://example.org/phongph5/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Tokens are bound by src/query.py, not raw user input.
SELECT ?match ?date ?homeName ?awayName ?goals WHERE {
 ?match fb:inSeason {{season}} ; fb:matchDate ?date ; fb:homeTeam/rdfs:label ?homeName ;
        fb:awayTeam/rdfs:label ?awayName ; fb:homeGoals ?goals ; fb:awayGoals ?awayGoals .
 FILTER(?goals = ?awayGoals)
} ORDER BY ?date ?match
