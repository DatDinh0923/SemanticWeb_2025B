PREFIX fb: <http://example.org/phongph5/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Tokens are bound by src/query.py, not raw user input.
SELECT ?match ?date ?homeName ?awayName ?homeGoals ?awayGoals ?total WHERE {
 { SELECT (MAX(?h + ?a) AS ?maximum) WHERE {
    ?m fb:inSeason {{season}} ; fb:homeGoals ?h ; fb:awayGoals ?a .
 } }
 ?match fb:inSeason {{season}} ; fb:matchDate ?date ; fb:homeTeam/rdfs:label ?homeName ;
        fb:awayTeam/rdfs:label ?awayName ; fb:homeGoals ?homeGoals ; fb:awayGoals ?awayGoals .
 BIND(?homeGoals + ?awayGoals AS ?total)
 FILTER(?total = ?maximum)
} ORDER BY ?date ?match
