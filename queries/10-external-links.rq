PREFIX fb: <http://example.org/phongph5/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Tokens are bound by src/query.py, not raw user input.
PREFIX owl: <http://www.w3.org/2002/07/owl#>
SELECT ?team ?name ?external WHERE {
 ?team a fb:Team ; rdfs:label ?name ; owl:sameAs ?external .
} ORDER BY ?name ?external
