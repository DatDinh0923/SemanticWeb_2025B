PREFIX fb: <http://example.org/phongph5/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Tokens are bound by src/query.py, not raw user input.
SELECT ?seasonLabel ?date ?homeName ?awayName ?homeGoals ?awayGoals ?winnerName WHERE {
 VALUES (?first ?second) { ({{team}} {{opponent}}) }
 ?match fb:inSeason/fb:seasonLabel ?seasonLabel ; fb:matchDate ?date ;
        fb:homeTeam ?home ; fb:awayTeam ?away ; fb:homeGoals ?homeGoals ; fb:awayGoals ?awayGoals .
 FILTER((?home = ?first && ?away = ?second) || (?home = ?second && ?away = ?first))
 ?home rdfs:label ?homeName . ?away rdfs:label ?awayName .
 OPTIONAL { ?match fb:winner/rdfs:label ?winnerName }
} ORDER BY ?date
