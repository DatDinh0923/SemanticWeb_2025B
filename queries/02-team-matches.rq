PREFIX fb: <http://example.org/phongph5/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Tokens are bound by src/query.py, not raw user input.
SELECT ?date ?round ?homeName ?awayName ?homeGoals ?awayGoals ?role WHERE {
 VALUES ?selected { {{team}} }
 ?match fb:inSeason {{season}} ; fb:matchDate ?date ; fb:roundNumber ?round ;
        fb:homeTeam ?home ; fb:awayTeam ?away ; fb:homeGoals ?homeGoals ; fb:awayGoals ?awayGoals .
 FILTER(?home = ?selected || ?away = ?selected)
 ?home rdfs:label ?homeName . ?away rdfs:label ?awayName .
 BIND(IF(?home = ?selected, "home", "away") AS ?role)
} ORDER BY ?date ?round
