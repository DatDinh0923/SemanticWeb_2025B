# CQ11: What is the final league table of a season (3 points for a win)?
# Ordered by points, goal difference, then goals scored.
PREFIX foot: <https://datdinh0923.github.io/SemanticWeb_2025B/ontology/>
PREFIX schema: <https://schema.org/>
PREFIX season: <https://datdinh0923.github.io/SemanticWeb_2025B/resource/season/>

SELECT ?team ?teamName
       (COUNT(?match) AS ?played)
       (SUM(?win) AS ?won)
       (SUM(?draw) AS ?drawn)
       (SUM(?loss) AS ?lost)
       (SUM(?scored) AS ?goalsFor)
       (SUM(?conceded) AS ?goalsAgainst)
       ((SUM(?scored) - SUM(?conceded)) AS ?goalDifference)
       ((SUM(?win) * 3 + SUM(?draw)) AS ?points)
WHERE {
    VALUES ?season { season:premier-league-2018-19 }
    # Each UNION branch carries the season pattern so engines without join
    # reordering (such as rdflib) only scan that season's matches.
    {
        ?match foot:playedInSeason ?season ;
               foot:homeTeam ?team ;
               foot:homeGoals ?scored ;
               foot:awayGoals ?conceded .
    }
    UNION
    {
        ?match foot:playedInSeason ?season ;
               foot:awayTeam ?team ;
               foot:awayGoals ?scored ;
               foot:homeGoals ?conceded .
    }
    ?team schema:name ?teamName .
    BIND(IF(?scored > ?conceded, 1, 0) AS ?win)
    BIND(IF(?scored = ?conceded, 1, 0) AS ?draw)
    BIND(IF(?scored < ?conceded, 1, 0) AS ?loss)
}
GROUP BY ?team ?teamName
ORDER BY DESC(?points) DESC(?goalDifference) DESC(?goalsFor) ?teamName
