PREFIX fb: <http://example.org/phongph5/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Tokens are bound by src/query.py, not raw user input.
SELECT ?team ?name (SUM(?home) AS ?homeGoals) (SUM(?away) AS ?awayGoals) WHERE {
 { ?match fb:inSeason {{season}} ; fb:homeTeam ?team ; fb:homeGoals ?home . BIND(0 AS ?away) }
 UNION
 { ?match fb:inSeason {{season}} ; fb:awayTeam ?team ; fb:awayGoals ?away . BIND(0 AS ?home) }
 ?team rdfs:label ?name .
} GROUP BY ?team ?name ORDER BY ?name
