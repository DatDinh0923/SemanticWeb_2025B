# CQ8: Which season and competition does each match belong to?
# Summarized as the number of matches per season and competition.
PREFIX foot: <https://datdinh0923.github.io/SemanticWeb_2025B/ontology/>
PREFIX schema: <https://schema.org/>

SELECT ?competitionName ?seasonName (COUNT(?match) AS ?matches)
WHERE {
    ?match a foot:FootballMatch ;
           foot:playedInSeason ?season ;
           foot:partOfCompetition ?competition .
    ?season schema:name ?seasonName .
    ?competition schema:name ?competitionName .
}
GROUP BY ?competitionName ?seasonName
ORDER BY ?seasonName
