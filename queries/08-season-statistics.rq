PREFIX fb: <http://example.org/phongph5/ontology#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
# Tokens are bound by src/query.py, not raw user input.
SELECT ?seasonLabel (COUNT(?match) AS ?matches)
 (SUM(?hg + ?ag) AS ?goals) (AVG(?hg + ?ag) AS ?averageGoals)
WHERE {
 ?match fb:inSeason/fb:seasonLabel ?seasonLabel ; fb:homeGoals ?hg ; fb:awayGoals ?ag .
} GROUP BY ?seasonLabel ORDER BY ?seasonLabel
