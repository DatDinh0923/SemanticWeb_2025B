@prefix fb: <http://example.org/phongph5/ontology#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix shape: <http://example.org/phongph5/shapes#> .

shape:Match a sh:NodeShape ; sh:targetClass fb:Match ; sh:nodeKind sh:IRI ;
    sh:property [ sh:path fb:homeTeam ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Team ; sh:nodeKind sh:IRI ; sh:disjoint fb:awayTeam ] ;
    sh:property [ sh:path fb:awayTeam ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Team ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path fb:inSeason ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Season ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path fb:matchDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path fb:roundNumber ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger ; sh:minInclusive 1 ; sh:maxInclusive 38 ] ;
    sh:property [ sh:path fb:homeGoals ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fb:awayGoals ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:nonNegativeInteger ; sh:minInclusive 0 ] ;
    sh:property [ sh:path fb:sourceFile ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:minLength 1 ] ;
    sh:property [ sh:path fb:sourceLine ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:positiveInteger ; sh:minInclusive 2 ] ;
    sh:property [ sh:path fb:winner ; sh:minCount 0 ; sh:maxCount 1 ; sh:class fb:Team ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path fb:loser ; sh:minCount 0 ; sh:maxCount 1 ; sh:class fb:Team ; sh:nodeKind sh:IRI ] .

# Evaluate cross-property rules once across the graph, not 7,600 separate queries.
shape:DataIntegrity a sh:NodeShape ; sh:targetNode <http://example.org/phongph5/dataset> ;
    sh:sparql [
        sh:message "Winner/loser must agree with the score; draws have neither." ;
        sh:select """
            PREFIX fb: <http://example.org/phongph5/ontology#>
            SELECT $this ?value WHERE {
                ?value a fb:Match ; fb:homeTeam ?h ; fb:awayTeam ?a ; fb:homeGoals ?hg ; fb:awayGoals ?ag .
                FILTER(
                    (?hg = ?ag && (EXISTS { ?value fb:winner ?w } || EXISTS { ?value fb:loser ?l })) ||
                    (?hg > ?ag && (NOT EXISTS { ?value fb:winner ?h } || NOT EXISTS { ?value fb:loser ?a })) ||
                    (?hg < ?ag && (NOT EXISTS { ?value fb:winner ?a } || NOT EXISTS { ?value fb:loser ?h }))
                )
            }
        """
    ] ;
    sh:sparql [
        sh:message "Match date must be inside its season's observed date range." ;
        sh:select """
            PREFIX fb: <http://example.org/phongph5/ontology#>
            SELECT $this ?value WHERE {
                ?value a fb:Match ; fb:matchDate ?d ; fb:inSeason ?s .
                ?s fb:startDate ?start ; fb:endDate ?end .
                FILTER(?d < ?start || ?d > ?end)
            }
        """
    ] .

shape:Season a sh:NodeShape ; sh:targetClass fb:Season ; sh:nodeKind sh:IRI ;
    sh:property [ sh:path fb:seasonOf ; sh:minCount 1 ; sh:maxCount 1 ; sh:class fb:Competition ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path fb:seasonLabel ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^20[0-9]{2}-[0-9]{2}$" ] ;
    sh:property [ sh:path fb:startDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ; sh:lessThanOrEquals fb:endDate ] ;
    sh:property [ sh:path fb:endDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] .

shape:Team a sh:NodeShape ; sh:targetClass fb:Team ; sh:nodeKind sh:IRI ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] .

shape:Competition a sh:NodeShape ; sh:targetClass fb:Competition ; sh:nodeKind sh:IRI ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:Literal ] .
