@prefix foot: <https://datdinh0923.github.io/SemanticWeb_2025B/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


foot:FootballTeamShape
    a sh:NodeShape ;
    sh:targetClass foot:FootballTeam ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ("en")
    ] ;
    sh:property [
        sh:path owl:sameAs ;
        sh:minCount 2 ;
        sh:nodeKind sh:IRI
    ] .

foot:CompetitionShape
    a sh:NodeShape ;
    sh:targetClass foot:Competition ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ("en")
    ] ;
    sh:property [
        sh:path schema:spatialCoverage ;
        sh:minCount 1 ;
        sh:maxCount 1
    ] .

foot:SeasonShape
    a sh:NodeShape ;
    sh:targetClass foot:Season ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ("en")
    ] ;
    sh:property [
        sh:path schema:startDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path schema:endDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path foot:partOfCompetition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class foot:Competition ;
        sh:nodeKind sh:IRI
    ] .

foot:FootballMatchShape
    a sh:NodeShape ;
    sh:targetClass foot:FootballMatch ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:languageIn ("en")
    ] ;
    sh:property [
        sh:path foot:homeTeam ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class foot:FootballTeam ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path foot:awayTeam ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class foot:FootballTeam ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path foot:homeGoals ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path foot:awayGoals ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:nonNegativeInteger ;
        sh:minInclusive 0
    ] ;
    sh:property [
        sh:path foot:matchDate ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:date
    ] ;
    sh:property [
        sh:path foot:roundNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:positiveInteger ;
        sh:minInclusive 1
    ] ;
    sh:property [
        sh:path foot:playedInSeason ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class foot:Season ;
        sh:nodeKind sh:IRI
    ] ;
    sh:property [
        sh:path foot:partOfCompetition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class foot:Competition ;
        sh:nodeKind sh:IRI
    ] ;
    sh:sparql [
        sh:message "The home and away teams must be different."@en ;
        sh:select """
            PREFIX foot: <https://datdinh0923.github.io/SemanticWeb_2025B/ontology/>
            SELECT $this
            WHERE {
                $this foot:homeTeam ?team ;
                      foot:awayTeam ?team .
            }
        """
    ] .
