# data: de-thi-thu-2.ttl
# Đề 2 – 3b. Món KHÔNG chứa nguyên liệu động vật nào (Meat, Seafood là lớp con của AnimalProduct).
PREFIX :     <http://example.org/food#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?name
WHERE {
  ?d a :Dish ; :name ?name .
  FILTER NOT EXISTS {
    ?d :hasIngredient ?i .
    ?i a/rdfs:subClassOf* :AnimalProduct .
  }
}
