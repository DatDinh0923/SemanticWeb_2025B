# data: de-thi-thu-2.ttl
# Đề 2 – 3a. Món giá dưới 40.000, kèm tên và giá, rẻ nhất trước.
PREFIX :     <http://example.org/food#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?name ?price
WHERE {
  ?d a :Dish ; :name ?name ; :price ?price .
  FILTER (?price < 40000)
}
ORDER BY ?price
